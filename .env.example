# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to .env.local and fill in the values.
#  NEVER commit real values — this repo is public. .env.local is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Instagram live feed (optional) ───────────────────────────────────────────
# Leave blank and the Instagram section simply does not render.
#
# Long-lived token from an Instagram BUSINESS or CREATOR account.
# Scope is read-only (instagram_business_basic): it cannot post, delete or
# read DMs. Generate it in the Meta App Dashboard — see README.md.
# Expires after 60 DAYS; the cron below renews it.
INSTAGRAM_ACCESS_TOKEN=

# Shared secret protecting /api/instagram/refresh.
#   openssl rand -hex 32
CRON_SECRET=

# ── Automatic token renewal (optional but recommended) ───────────────────────
# With these set, the monthly cron renews the Instagram token AND writes the
# new value back to Vercel, so you never touch it again. Without them the cron
# still renews but returns the token for you to paste in manually.
#
# Vercel account token: https://vercel.com/account/tokens  (scope it to this project)
VERCEL_API_TOKEN=
# Project Settings → General → Project ID
VERCEL_PROJECT_ID=
# Only if the project sits under a team, not a personal account
VERCEL_TEAM_ID=
# Project Settings → Git → Deploy Hooks. Needed because an env var change only
# takes effect on the next deployment.
VERCEL_DEPLOY_HOOK_URL=

# ── Blog (optional) ──────────────────────────────────────────────────────────
# The WordPress site root — the REST path is added automatically.
# Publishing a post in WordPress makes it appear at /blog within ~10 minutes.
# Leave blank and /blog shows an empty state; nothing else is affected.
WORDPRESS_API_URL=

# ── Audit form → Go High Level (required for the form to work) ───────────────
# Private integration token from GHL. Treat it like a password: it can read and
# write every contact in the sub-account. Never commit it.
GHL_API_TOKEN=
# The GHL sub-account the contacts belong to.
GHL_LOCATION_ID=
